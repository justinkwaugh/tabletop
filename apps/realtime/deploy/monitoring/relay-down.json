{
    "displayName": "Realtime relay down",
    "combiner": "OR",
    "conditions": [
        {
            "displayName": "events.boardtogether.games/health failing from two or more regions",
            "conditionThreshold": {
                "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type=\"uptime_url\" AND metric.label.check_id=\"CHECK_ID\"",
                "aggregations": [
                    {
                        "alignmentPeriod": "1200s",
                        "perSeriesAligner": "ALIGN_NEXT_OLDER",
                        "crossSeriesReducer": "REDUCE_COUNT_FALSE",
                        "groupByFields": [
                            "resource.label.host"
                        ]
                    }
                ],
                "comparison": "COMPARISON_GT",
                "thresholdValue": 1,
                "duration": "600s",
                "trigger": {
                    "count": 1
                }
            }
        }
    ],
    "alertStrategy": {
        "autoClose": "1800s"
    },
    "documentation": {
        "mimeType": "text/markdown",
        "content": "The relay or its Redis subscriber has been unreachable for about 10 minutes. Check `systemctl status realtime caddy` and `journalctl -u realtime` on the `realtime` VM over IAP. Clients fall back to reconnecting with backoff."
    },
    "notificationChannels": [
        "CHANNEL"
    ]
}
