#!/bin/bash
set -euo pipefail

metadata=http://metadata.google.internal/computeMetadata/v1
project=$(curl -fsS -H 'Metadata-Flavor: Google' "$metadata/project/project-id")
access_token=$(curl -fsS -H 'Metadata-Flavor: Google' "$metadata/instance/service-accounts/default/token" | jq -r .access_token)

secret() {
	local value
	value=$(curl -fsS -H "Authorization: Bearer $access_token" \
		"https://secretmanager.googleapis.com/v1/projects/$project/secrets/$1/versions/latest:access" \
		| jq -r .payload.data | base64 -d)
	if [[ -z $value || $value == *[\'\\$'\n']* ]]; then
		echo "Secret $1 is empty or contains a quote, backslash or newline" >&2
		return 1
	fi
	printf '%s' "$value"
}

signing_key=$(secret REALTIME_SIGNING_KEY)
redis_username=$(secret REDIS_USERNAME)
redis_password=$(secret REDIS_PASSWORD)

umask 077
mkdir -p /run/realtime-relay
printf "REALTIME_SIGNING_KEYS='%s'\nREDIS_USERNAME='%s'\nREDIS_PASSWORD='%s'\n" \
	"$signing_key" "$redis_username" "$redis_password" > /run/realtime-relay/secrets.env.new
mv /run/realtime-relay/secrets.env.new /run/realtime-relay/secrets.env
