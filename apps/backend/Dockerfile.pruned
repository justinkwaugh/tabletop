# Run the container with `docker run -p 3000:3000 -t backend`.

# Build/deps stage (pruned context).
FROM docker.io/node:24-trixie AS builder

ENV HOST=0.0.0.0
WORKDIR /app

RUN apt-get update && apt-get install -y make gcc g++ python3 curl

COPY json/ /app/
COPY pnpm-workspace.yaml /app/pnpm-workspace.yaml
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
RUN pnpm install --frozen-lockfile

COPY full/ /app/

RUN pnpm install --frozen-lockfile

RUN pnpm turbo run build --no-cache --no-daemon \
    --filter=@tabletop/common \
    --filter=@tabletop/backend-services \
    --filter=@tabletop/email \
    --filter=@tabletop/games-config \
    --filter=@tabletop/backend

RUN pnpm deploy --legacy --filter=@tabletop/backend --prod /app/deploy

RUN if [ -f /app/apps/backend/.env.prod ]; then cp /app/apps/backend/.env.prod /app/deploy/.env; fi

# Runtime stage (distroless).
FROM gcr.io/distroless/nodejs24-debian13

ENV NODE_ENV=production
ENV HOST=0.0.0.0

WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /app/deploy /app

USER nonroot

EXPOSE 8080

# Node sizes old space at half the container, which the loaded titles reach long before the
# 1 GiB services are full; about 270 MiB sits outside it. Resize this with the services' memory.
CMD [ "--env-file=.env", "--max-old-space-size=640", "dist/main.js" ]
