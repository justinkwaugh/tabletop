PUBLIC_API_HOST=""
PUBLIC_SSE_HOST=""


PUBLIC_ENABLE_ABLY_REALTIME=
# The realtime relay (apps/realtime), such as https://events.boardtogether.games. When set, it
# carries Realtime Updates instead of Ably or the backend's SSE routes.
PUBLIC_REALTIME_RELAY_HOST=
PUBLIC_ENABLE_DISCORD_LOGIN=
# The public URL of the bucket holding the game UI bundles. When set, the site imports them from
# there; leave empty to import them from the site itself.
PUBLIC_GAME_UI_BASE_URL=
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_VAPID_KEY=
