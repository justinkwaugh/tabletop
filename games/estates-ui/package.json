{
    "name": "@tabletop/estates-ui",
    "version": "3.6.1",
    "private": true,
    "type": "module",
    "svelte": "./dist/index.js",
    "types": "./dist/index.ts",
    "scripts": {
        "dev": "vite dev",
        "clean": "rimraf bundle && rimraf build && rimraf dist",
        "build": "vite build && pnpm run package",
        "bundle": "svelte-kit sync && rimraf bundle && rollup -c ./rollup.config.ts",
        "stage-ui": "node ../../tools/deploy/scripts/stage-ui.mjs",
        "package": "svelte-kit sync && svelte-package",
        "test": "pnpm run test:integration && pnpm run test:unit",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "test:integration": "playwright test",
        "test:unit": "vitest"
    },
    "exports": {
        ".": {
            "types": "./dist/index.ts",
            "svelte": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "peerDependencies": {
        "@sveltejs/kit": "^2.48.4",
        "svelte": "^5.0.0"
    },
    "dependencies": {
        "@tabletop/common": "workspace:*",
        "@tabletop/estates": "workspace:*",
        "@tabletop/frontend-components": "workspace:*",
        "@threlte/core": "8.6.0",
        "@threlte/extras": "9.21.1",
        "@types/three": "0.182.0",
        "camera-controls": "github:justinkwaugh/camera-controls",
        "gsap": "^3.14.2",
        "svelte-tweakpane-ui": "^1.5.13",
        "three": "0.182.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.42.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.48.4",
        "@sveltejs/package": "^2.5.7",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tabletop/eslint-config": "workspace:*",
        "@tabletop/rollup-config": "workspace:*",
        "@tabletop/vitest-config": "workspace:*",
        "@tailwindcss/postcss": "^4.1.18",
        "eslint": "^9.39.2",
        "flowbite": "^3.1.2",
        "flowbite-svelte": "^1.31.0",
        "flowbite-svelte-icons": "^3.1.0",
        "postcss": "^8.5.6",
        "postprocessing": "^6.38.2",
        "prettier": "^3.8.0",
        "prettier-plugin-svelte": "^3.4.1",
        "rollup": "4.55.2",
        "svelte": "^5.0.0",
        "svelte-check": "^4.3.5",
        "tailwindcss": "^4.1.18",
        "typescript": "5.9.3",
        "vite": "^7.3.1"
    }
}
