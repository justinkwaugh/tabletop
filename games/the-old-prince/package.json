{
    "name": "@tabletop/the-old-prince",
    "version": "11.3.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./esm/index.d.ts",
            "import": "./esm/index.js"
        },
        "./scenarios": {
            "types": "./esm/scenarios/index.d.ts",
            "import": "./esm/scenarios/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "esm"
    ],
    "scripts": {
        "clean": "rimraf esm",
        "build": "node ../../tools/scripts/write-game-version.cjs && tsgo",
        "check": "tsgo --noEmit",
        "test": "vitest run",
        "bundle": "rimraf bundle && node ../../tools/scripts/write-game-version.cjs && rolldown -c ./rolldown.config.ts",
        "lint": "eslint ."
    },
    "dependencies": {
        "@tabletop/18xx": "workspace:*",
        "@tabletop/common": "workspace:*",
        "typebox": "^1.0.79"
    },
    "devDependencies": {
        "@tabletop/vitest-config": "workspace:*",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "rimraf": "^6.1.0",
        "typescript": "5.9.3",
        "vitest": "^5.0.5",
        "@tabletop/rolldown-config": "workspace:*",
        "rolldown": "^1.2.15",
        "@tabletop/18xx-autorouter": "workspace:*",
        "@tabletop/eslint-config": "workspace:*"
    }
}
