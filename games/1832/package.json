{
    "name": "@tabletop/1832",
    "version": "2.2.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./esm/index.d.ts",
            "import": "./esm/index.js"
        },
        "./scenarios": {
            "types": "./esm/scenarios/index.d.ts",
            "import": "./esm/scenarios/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "esm"
    ],
    "scripts": {
        "clean": "rimraf esm",
        "build": "node ../../tools/scripts/write-game-version.cjs && tsgo",
        "check": "tsgo --noEmit && tsgo -p tsconfig.test-types.json",
        "test": "vitest run",
        "bundle": "rimraf bundle && node ../../tools/scripts/write-game-version.cjs && rollup -c ./rollup.config.ts",
        "lint": "eslint ."
    },
    "dependencies": {
        "@tabletop/18xx": "workspace:*",
        "@tabletop/common": "workspace:*"
    },
    "devDependencies": {
        "@tabletop/18xx-autorouter": "workspace:*",
        "@tabletop/eslint-config": "workspace:*",
        "@tabletop/rollup-config": "workspace:*",
        "@tabletop/vitest-config": "workspace:*",
        "@types/node": "^25.9.9",
        "@typescript/native-preview": "7.0.0-dev.20260203.1",
        "rimraf": "^6.1.0",
        "rollup": "4.55.2",
        "typebox": "^1.0.79",
        "typescript": "5.9.3",
        "vitest": "^4.0.12"
    }
}
