{
    "name": "@tabletop/18xx-ui",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "scripts": {
        "clean": "rimraf .svelte-kit dist",
        "build": "pnpm run package",
        "package": "svelte-kit sync && svelte-package",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run"
    },
    "peerDependencies": {
        "@sveltejs/kit": "^2.48.4",
        "svelte": "^5.0.0"
    },
    "dependencies": {
        "@tabletop/18xx": "workspace:*",
        "@tabletop/common": "workspace:*",
        "@tabletop/frontend-components": "workspace:*"
    },
    "devDependencies": {
        "@sveltejs/kit": "^2.48.4",
        "@sveltejs/package": "^2.5.7",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "rimraf": "^6.1.0",
        "svelte": "^5.0.0",
        "svelte-check": "^4.3.5",
        "typescript": "5.9.3",
        "vite": "^7.3.1",
        "@tabletop/vitest-config": "workspace:*",
        "vitest": "^4.0.12",
        "prettier-plugin-svelte": "^3.4.1"
    }
}
