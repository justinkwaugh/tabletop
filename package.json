{
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "check": "turbo run check",
        "clean": "turbo run clean",
        "clean:node": "rimraf node_modules /**/node_modules",
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "watch": "turbo watch dev --filter=@tabletop/frontend --filter=@tabletop/backend",
        "dev": "turbo dev --filter=@tabletop/frontend --filter=@tabletop/backend",
        "email": "turbo watch dev --filter=@tabletop/email",
        "lint": "turbo run lint",
        "test": "vitest",
        "watch:frontend": "turbo watch dev --filter=@tabletop/frontend",
        "watch:backend": "turbo watch dev --filter=@tabletop/backend",
        "start:backend": "turbo run start --filter=@tabletop/backend",
        "update-games": "turbo update-games",
        "bug-reports": "node tools/bug-reports/src/cli.mjs",
        "deploy": "node tools/deploy/esm/cli.js",
        "investigate": "node tools/investigate/src/cli.mjs",
        "rehearse": "pnpm --filter @tabletop/tools exec tsx src/rehearsal/cli.mjs"
    },
    "devDependencies": {
        "@turbo/gen": "^2.8.0",
        "@types/react": "^19.2.2",
        "eslint": "^9.39.2",
        "prettier": "^3.8.0",
        "rimraf": "^6.1.2",
        "turbo": "^2.8.0",
        "vitest": "^4.0.17"
    },
    "engines": {
        "node": ">=24"
    },
    "name": "tabletop",
    "packageManager": "pnpm@10.28.2",
    "workspaces": [
        "libs/*",
        "games/*",
        "apps/*",
        "config/*",
        "tools/*"
    ],
    "dependencies": {
        "nanoid": "5.1.6"
    }
}
